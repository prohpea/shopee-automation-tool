# Shopee Automation Tool Configuration
# Copy this file to .env and adjust your settings

# Region configuration: vn, sg, my, th, id, ph, tw
SHOPEE_REGION=vn

# Headless mode: false for interactive login/debugging, true for background tasks
HEADLESS=false

# Session storage name (without .json)
DEFAULT_SESSION=default

# Human delay settings (seconds)
MIN_ACTION_DELAY=1.5
MAX_ACTION_DELAY=3.5

# Navigation timeout in milliseconds
NAV_TIMEOUT_MS=45000

# Proxy settings (optional, leave blank if not used)
# Format: http://user:pass@host:port or http://host:port
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Anti-detection
STEALTH_MODE=true
USER_AGENT=
